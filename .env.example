# li2-oss — mẫu biến môi trường.
#
# Dùng: `cp .env.example .env` rồi điền. KHÔNG có giá trị thật nào trong file này, và nó là
# file duy nhất họ `.env*` được commit (xem .gitignore).
#
# Chạy bằng `docker compose up` thì chỉ cần điền SESSION_SECRET và PUBLIC_BASE_URL;
# những biến còn lại docker-compose.yml đã đặt sẵn giá trị dùng được.

# ─────────────────────────────────────────────────────────── BẮT BUỘC

# Khoá ký session cookie, và cũng là muối cho mã khách truy cập (lib/analytics/visitor.ts).
# KHÔNG CÓ GIÁ TRỊ MẶC ĐỊNH, theo chủ ý: docker-compose.yml dùng `${SESSION_SECRET:?...}` nên
# `docker compose up` sẽ DỪNG với thông báo nếu biến này trống. Một secret mặc định trong repo
# là một secret mà mọi bản cài đều dùng chung.
#
# Sinh một giá trị:
#   openssl rand -base64 32
#
# Đổi giá trị này làm mất hiệu lực mọi session đang đăng nhập (và làm mã khách truy cập cũ
# không còn khớp với mã mới — thống kê khách duy nhất trước đó vẫn đọc được, chỉ không nối
# được với sau đó).
SESSION_SECRET=

# Địa chỉ công khai của instance NÀY, không có dấu `/` ở cuối. Ví dụ: https://link.cua-ban.com
#
# ⚠ ĐỂ RỖNG CHO ĐẾN KHI BẠN ĐIỀN ĐỊA CHỈ CỦA MÌNH. Không có mặc định trỏ tới domain của bất kỳ ai —
# đây là điều kiện trung tâm của docs/ADR-001-kien-truc.md. Bản thương mại hard-code `li2.ai` ở
# 59 file, và một trong số đó mời người tự host đăng ký link trên domain của Li2. Một bản
# self-host phải phục vụ domain của người cài, không phải domain của người viết code.
#
# Giá trị này được dùng để dựng URL đầy đủ trong QR, trong trang quản lý, và trong email.
# Điền sai thì QR in ra trỏ sai chỗ, và không in lại được.
#
# Chạy thử ở máy: http://localhost:3000
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────── KẾT NỐI DB

# Chuỗi kết nối Postgres. Bắt buộc khi chạy NGOÀI Docker (`yarn dev`).
# Chạy bằng docker compose thì bỏ trống — compose tự dựng từ POSTGRES_PASSWORD.
#   postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=

# Mật khẩu cho container Postgres mà docker-compose.yml dựng lên.
# Bỏ trống thì compose dùng mặc định `li2_dev_only` — chỉ dùng được ở máy cá nhân.
# Đưa lên máy chủ thật thì ĐIỀN. Sinh một giá trị: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────── TUỲ CHỌN

# Nơi lưu tệp người dùng tải lên. Trong Docker đã là /data/artifacts (một volume), đừng đổi.
# Chạy ngoài Docker thì trỏ tới một thư mục ghi được, ví dụ ./data/artifacts
STORAGE_DIR=

# Giới hạn kích thước một tệp tải lên, tính bằng byte. Bỏ trống = 30 MiB (31457280).
MAX_UPLOAD_BYTES=

# Đặt `true` CHỈ KHI instance đứng sau một reverse proxy mà bạn kiểm soát (nginx, Traefik,
# Cloudflare). Lúc đó `x-forwarded-for` được tin để lấy IP thật.
#
# Đặt `true` khi KHÔNG có proxy nghĩa là để khách tự khai IP của họ — mọi phép đếm khách duy
# nhất thành số do client bịa. Mặc định `false` (đếm thiếu, hơn là đếm sai).
TRUSTED_PROXY=false

# Cổng công khai ở máy host. Bỏ trống = 3000.
PORT=

# Cookie phiên có gắn cờ `Secure` không. Mặc định true.
#
# Đặt `false` NẾU bạn chạy HTTP trên mạng riêng (LAN, Tailscale, WireGuard). Không đặt thì trình
# duyệt vứt cookie và bạn sẽ thấy "đăng nhập trả 200 nhưng vẫn ở trang login" — lỗi rất khó đoán,
# và nó chỉ hiện khi mở từ MÁY KHÁC (trên localhost vẫn chạy vì trình duyệt tin localhost).
#
# ⚠ Tắt nghĩa là cookie phiên đi qua mạng không mã hoá. Chỉ làm trên mạng bạn tin. Đường đúng là
# đặt HTTPS trước app: Caddy, nginx, hoặc `tailscale serve --bg --https=443 http://127.0.0.1:3000`.
COOKIE_SECURE=
