SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=


# Shlink config
# @required
SHLINK_API_URL=
SHLINK_API_KEY=
NEXT_PUBLIC_SHORT_LINK_URL=


# Sentry config
# @optional
SENTRY_DSN=



# Casdoor config
# @required
NEXT_PUBLIC_CASDOOR_CLIENT_ID=
NEXT_PUBLIC_CASDOOR_ORG_NAME=
NEXT_PUBLIC_CASDOOR_APP_NAME=
NEXT_PUBLIC_CASDOOR_APP_URL=
NEXT_PUBLIC_CASDOOR_BASE64_CERT=
CASDOOR_CLIENT_SECRET=
CASDOOR_MASTER_PASSWORD=

# Google config
# @optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_API_KEY=

# Redis config
# @required
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_TLS=false

# SSE Notification config
# @optional - URL to external SSE service for real-time notifications
NEXT_PUBLIC_SSE_ENDPOINT=

# Mautic config
# @optional
NEXT_PUBLIC_MAUTIC_FORM_ID=
NEXT_PUBLIC_MAUTIC_FORM_NAME=
NEXT_PUBLIC_GA_CONFIG=
NEXT_PUBLIC_APP_GA_ID=
# Momo config
# @optional
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_CODE=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_LANG=
MOMO_CREATE_PAYMENT_URL=
MOMO_CHECK_TRANSACTION_URL=

# Parcelvoy config
# @optional
NEXT_PUBLIC_PARCELVOY_URL=

# Auth config
# @optional
AUTH_CALLBACK_URL=

# Demo mode config
# @optional - Enable demo mode for unauthenticated preview
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
NEXT_PUBLIC_DEMO_ENABLED=false

# Facebook tracking config
# @optional - For Facebook Conversions API tracking
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PIXEL_ID=

# GA4 Measurement Protocol config
# @optional - For server-side GA4 tracking (sign_up_success event)
# GA4_MEASUREMENT_ID uses NEXT_PUBLIC_APP_GA_ID by default
GA4_API_SECRET=

# Next.js Server Actions encryption key
# @required for multi-instance deployments - ensures consistent encryption across all server instances
# Generate with: openssl rand -hex 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# SDK toolbar
TOOLBAR_SESSION_SECRET=

# Google Safe Browsing API v5 — checks destination URLs of short links against Google's threat lists.
# LEAVING THIS EMPTY DISABLES THAT CHECK: every destination URL passes, link creation keeps working,
# and the app logs one warning per process ("URL blacklist checking is disabled"). The two other
# layers (admin regex blacklist + domain bloom filter) still run.
# How to get a key (steps read 2026-10-21 from https://developers.google.com/safe-browsing/v4/get-started):
#   1. Google Cloud Console (https://console.cloud.google.com) → create or pick a project
#   2. APIs & Services → Credentials → Create credentials → API key, then copy it
#   3. APIs & Services → Library → enable "Safe Browsing APIs"
#   4. Review the Usage Limits page before relying on it in production
# API reference: https://developers.google.com/safe-browsing/reference
GOOGLE_SAFE_BROWSING_API_KEY=

# AI Proxy (Not LiteLLM)
PROXY_API_KEY=
PROXY_BASE_URL=

# DEMO MODE
NEXT_PUBLIC_DEMO_ENABLED=
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

CASDOOR_MASTER_PASSWORD=

# AI Agent Platform — Phase 0 (PASETO v4.public, Ed25519)
# @required for the agent feature. li2-app MINTS (private key) and VERIFIES the back hop (public key).
# li2-ai holds ONLY the public key. See plans/ai-agent-platform/phase-0-walking-skeleton/KEYPAIR.md.
# Values are PASERK strings, NOT base64 PEM: the private key starts with `k4.secret.` and the
# public key with `k4.public.` (what `paseto-ts` returns and what `src/shared/lib/agent/paseto.ts`
# feeds straight to sign/verify). Paste a PEM here and minting fails at the first tool call.
# Generate a pair without printing it to a terminal:
#   umask 077 && node --input-type=module -e "import {generateKeys} from 'paseto-ts/v4';\
#     import {writeFileSync} from 'fs'; const k=generateKeys('public');\
#     writeFileSync('agent-paseto.env', \`AGENT_PASETO_PRIVATE_KEY=\${k.secretKey}\nAGENT_PASETO_PUBLIC_KEY=\${k.publicKey}\nAGENT_PASETO_KEY_ID=k1\n\`)"
AGENT_PASETO_PRIVATE_KEY=
AGENT_PASETO_PUBLIC_KEY=
# Current signing key id (goes in the PASETO footer for rotation). e.g. k1
AGENT_PASETO_KEY_ID=
# Optional: JSON map {kid: k4.public...} of all trusted public keys, for key rollover.
# When set, the verifier picks the key by the token's footer kid. MVP can ship with one entry.
AGENT_PASETO_PUBLIC_KEYS=
# Base URL li2-ai uses for the back hop to li2-app (informational here; consumed by li2-ai).
# NEXT_PUBLIC base URL of the li2-ai service the browser opens the SSE turn against:
NEXT_PUBLIC_LI2_AI_BASE_URL=

# Artifact (/a/<token>) — quyền xem. Pha 1: bắt buộc khi có artifact ở chế độ password/google.
# Thiếu → mọi chế độ không-public trả 503 (fail closed). `openssl rand -hex 32`, tối thiểu 32 ký tự.
# Host công khai của artifact (vd https://artifact.li2.link). Khi đặt: địa chỉ chia sẻ của artifact là
# <host>/<org_slug>/<slug> (app phục vụ, Traefik trỏ host này vào app); `/a/<token>` mở trực tiếp sẽ 302
# sang đó; short link (li2.link/<slug>) vẫn 302 như mọi touch point. Bỏ trống = hành vi cũ (/a/<token>).
ARTIFACT_LINK_URL=
ARTIFACT_VIEWER_SECRET=
# Pha 2 — chế độ "Đăng nhập Google" cho người xem. Cả hai trống → chế độ không tồn tại (UI ẩn, API 400).
# OAuth client riêng trên Google Cloud, redirect URI: <NEXT_PUBLIC_APP_BASE_URL>/a/google/callback
ARTIFACT_GOOGLE_CLIENT_ID=
ARTIFACT_GOOGLE_CLIENT_SECRET=
# Base URL công khai của app — dùng để dựng serve_url, redirect_to và redirect URI Google.
NEXT_PUBLIC_APP_BASE_URL=

# ---- MCP server (/api/mcp) ----
# Origin được phép gọi /api/mcp từ trình duyệt (chống DNS rebinding, spec MCP bắt buộc). CSV.
# THÊM VÀO danh sách mặc định (claude.ai, claude.com, chatgpt.com, chat.openai.com,
# platform.openai.com, cộng origin của NEXT_PUBLIC_APP_BASE_URL) — không thay thế nó.
# Chỉ chặn khi request CÓ header Origin và không khớp; client không gửi Origin (Claude Code,
# MCP Inspector, curl) luôn qua. Để trống là đủ cho hầu hết deploy.
MCP_ALLOWED_ORIGINS=

# ---- Ẩn module trên sidebar (self-host) ----
# 'true' = ẩn, để trống = hiện
# Ẩn cả nhóm Overview (Get started + Overview + Dashboards)
NEXT_PUBLIC_DISABLE_OVERVIEW_GROUP=
# Ẩn riêng mục Get started (onboarding)
NEXT_PUBLIC_DISABLE_ONBOARDING=
# Ẩn riêng mục Dashboards
NEXT_PUBLIC_DISABLE_DASHBOARDS=
NEXT_PUBLIC_DISABLE_CONVERSIONS=
NEXT_PUBLIC_DISABLE_CUSTOMERS=
# Ẩn cả nhóm Behavior analytics (link journey, funnels, site analytics, session recordings, event rules, forms)
NEXT_PUBLIC_DISABLE_BEHAVIOR_ANALYTICS=
# Ẩn khối "Roadmap & Requests" ở cuối sidebar (và không tải SDK Canny)
NEXT_PUBLIC_DISABLE_ROADMAP=
# Ẩn bubble chat hỗ trợ Chatwoot (và không tải SDK Chatwoot)
NEXT_PUBLIC_DISABLE_SUPPORT_CHAT=
# Ẩn nút "Hỏi AI" trên navbar và panel chat AI
NEXT_PUBLIC_DISABLE_AI_CHAT=
# Section mặc định khi vào /org/<id> và sau khi tạo org. Trống = 'overview'. Ví dụ: short-links
NEXT_PUBLIC_ORG_HOME_SECTION=

# ---- Quét virus file artifact (ClamAV) ----
# Bật/tắt lớp quét. Mặc định TẮT: merge code mà chưa dựng container clamd thì mọi thứ chạy y như cũ.
# Bật là FAIL-CLOSED — clamd không trả lời thì upload bị từ chối 503, nên chỉ đặt true SAU khi
# /api/internal/scan-health trả reachable=true (xem docs/artifact-scan-clamav-spec.md §6).
CLAMAV_ENABLED=false
# Tên service của clamd trong docker network (lihi-internal). Để trống khi ENABLED=true sẽ ném lỗi.
CLAMAV_HOST=clamav
# Cổng clamd. Không bao giờ publish ra host: clamd không có xác thực.
CLAMAV_PORT=3310
# Trần thời gian chờ một lần quét, tính cả lúc clamd reload database. Hết hạn = từ chối upload.
CLAMAV_TIMEOUT_MS=15000
# Secret cho các route /api/internal/* (hiện: scan-health). Gửi qua header x-internal-secret.
# Trống = route trả 503, không phải mở. `openssl rand -hex 32`.
INTERNAL_API_SECRET=

# ---- Các cờ ẩn module còn lại (từ QQuik main) ----
# Giá trị =true dưới đây là cách deploy của QQuik, KHÔNG phải mặc định của self-host.
# File này chỉ là ví dụ, không được đọc lúc chạy — xem `src/shared/constants/disabled-features.ts`
# cho danh sách đầy đủ, và `.env.production` của từng thư mục build cho giá trị thật.
NEXT_PUBLIC_DISABLE_CAMPAIGNS=true
NEXT_PUBLIC_DISABLE_INTEGRATIONS=true

NEXT_PUBLIC_DISABLE_FACEBOOK_TRACKING=true
NEXT_PUBLIC_DISABLE_GA_TRACKING=true
NEXT_PUBLIC_DISABLE_TIKTOK_TRACKING=true
NEXT_PUBLIC_DISABLE_LINK_JOURNEY=true
#NEXT_PUBLIC_DISABLE_HEATMAP=false
NEXT_PUBLIC_DISABLE_FORM_ANALYTICS=true

# Ẩn cả nhóm Link attribution (Conversions + Customers). Cộng dồn với hai cờ riêng ở trên.
NEXT_PUBLIC_DISABLE_ATTRIBUTION=true
# Ẩn mục Developer settings
NEXT_PUBLIC_DISABLE_DEVELOPER_SETTINGS=true
# Ẩn riêng mục Deep link analytics (cờ này THẮNG cả gói Pro — xem use-plan-features.ts)
NEXT_PUBLIC_DISABLE_DEEP_LINK_ANALYTICS=
# Ẩn mục Session recordings
NEXT_PUBLIC_DISABLE_SESSION_RECORDING=

# Bản đồ chọn vị trí (Mapbox). Lấy khoá tại https://account.mapbox.com/access-tokens
# Bỏ trống thì ô bản đồ không hiện; phần còn lại vẫn chạy.
NEXT_PUBLIC_MAPBOX_TOKEN=
