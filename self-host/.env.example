# Cấu hình bản self-host. Chép thành `.env` rồi chạy `./generate-keys.sh`.
#
#     cp .env.example .env
#     ./generate-keys.sh
#     docker compose up -d
#
# Script sẽ tự điền mọi dòng để trống ở mục A. Mục B phải tự điền tay sau lần chạy đầu.
# Mục C là tuỳ chọn — bỏ trống thì tính năng tương ứng tắt, app vẫn chạy.
#
# ⚠ KHÔNG commit file `.env`. `.gitignore` đã chặn, nhưng vẫn nên biết.

# ─────────────────────────────────────────────────────────────────────────────
# A. Bí mật — để TRỐNG, `./generate-keys.sh` sẽ sinh
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=
CASDOOR_DB_PASSWORD=
REDIS_PASSWORD=

# JWT_SECRET ký cả ANON_KEY lẫn SERVICE_KEY. Đổi nó là vô hiệu cả hai.
JWT_SECRET=
ANON_KEY=
SERVICE_KEY=

# Ba biến dưới là bản sao của ba biến trên dưới tên mà mã nguồn đọc.
# `generate-keys.sh` tự đồng bộ — đừng sửa tay một bên.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# B. Địa chỉ và Casdoor — PHẢI tự điền
# ─────────────────────────────────────────────────────────────────────────────

# Địa chỉ công khai của instance NÀY. Không có domain thì để nguyên localhost.
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
PORT=3000

# ⚠ Cookie phiên đặt cờ `Secure`, và trình duyệt VỨT cookie Secure trên HTTP thường — TRỪ
# localhost, vốn được coi là nguồn tin cậy. Nghĩa là chạy HTTP trên IP LAN hay Tailscale sẽ
# đăng nhập xong bị đá về trang đăng nhập, không báo lỗi gì. Hoặc dựng HTTPS, hoặc dùng
# localhost. Đây là lỗi đã mất một buổi để tìm ra.

CASDOOR_PORT=8000
CASDOOR_BASE_URL=http://localhost:8000
# ⚠ _APP_URL là biến mã thật đọc (7 chỗ). _BASE chỉ 1 chỗ. Đặt cả hai cho chắc.
NEXT_PUBLIC_CASDOOR_APP_URL=http://localhost:8000
NEXT_PUBLIC_CASDOOR_BASE=http://localhost:8000

# Bốn giá trị dưới lấy TỪ Casdoor sau lần `up` đầu tiên:
#   1. mở http://localhost:8000, đăng nhập admin / 123 rồi ĐỔI MẬT KHẨU NGAY
#   2. Identity → Applications → tạo application, đặt redirect URI
#      http://localhost:3000/auth/callback
#   3. chép Client ID và Client Secret xuống đây
NEXT_PUBLIC_CASDOOR_ORG_NAME=
NEXT_PUBLIC_CASDOOR_APP_NAME=
NEXT_PUBLIC_CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=

# Chứng chỉ công khai Casdoor dùng để KÝ token, mã hoá base64. Thiếu nó thì đăng nhập đi tới
# bước cuối rồi chết với ERR_JWS_SIGNATURE_VERIFICATION_FAILED — app lấy được token nhưng
# không xác minh nổi chữ ký. Lấy bằng:
#
#   docker compose exec -T casdoor-db psql -U casdoor -d casdoor -t -A \
#     -c "select certificate from cert where name='cert-built-in'" \
#     | sed 's/\\n/\n/g' | base64 | tr -d '\n'
NEXT_PUBLIC_CASDOOR_BASE64_CERT=

# Trình duyệt gọi thẳng Supabase cho phần tải tệp lên, nên nó cần địa chỉ tới được từ NGOÀI
# container. Cổng Kong đã publish sẵn ở 8001.
SUPABASE_PORT=8001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8001

# Bản phát hành. `oss` ẩn các tính năng thương mại (mã ở `src/ee/`).
NEXT_PUBLIC_EDITION=oss

# ─────────────────────────────────────────────────────────────────────────────
# C. Tuỳ chọn — bỏ trống là tắt tính năng tương ứng
# ─────────────────────────────────────────────────────────────────────────────

# Cổng LLM. Bất kỳ endpoint tương thích OpenAI nào: OpenAI, LiteLLM, Ollama, vLLM.
# Bỏ trống thì cụm AI (Hỏi AI, gợi ý slug, smart setup) tắt.
LI2_AI_GATEWAY_URL=
LI2_AI_GATEWAY_KEY=
LI2_AI_MODEL=

# Quét mã độc tệp tải lên. Cần container ClamAV riêng, chưa có trong compose này.
CLAMAV_ENABLED=false

# Redis chạy trong compose; ba biến dưới do docker-compose.yml đặt, không cần sửa.
# REDIS_PASSWORD nằm ở mục A.

# Bản đồ chọn vị trí (Mapbox). Lấy khoá ở https://account.mapbox.com/access-tokens
# Bỏ trống thì ô bản đồ không hiện; phần còn lại vẫn chạy.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cỡ tệp tối đa, byte. Mặc định 50 MB.
MAX_UPLOAD_BYTES=52428800

# Còn khoảng 80 biến tuỳ chọn khác (Google Sheets, Facebook, GA4, Safe Browsing...).
# Xem `../.env.example` — tất cả đều có thể bỏ trống.
